# DIKA production ortam degiskenleri sablonu.
#
# Bu dosyayi KOPYALAYIP gercek degerlerle doldur, sunucuda repo disinda
# guvenli bir konuma koy (ornek: /etc/dika/dika.env) ve izinlerini kisitla:
#
#   sudo cp deploy/dika.env.example /etc/dika/dika.env
#   sudo chown root:root /etc/dika/dika.env
#   sudo chmod 600 /etc/dika/dika.env
#
# /etc/dika/dika.env dosyasini ASLA git'e ekleme.

# Flask session imzalama anahtari. Asagidaki komutla yeni bir tane uret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DIKA_SECRET_KEY=degistir-bu-degeri-rastgele-uzun-bir-anahtarla

# MySQL baglanti bilgileri
DIKA_DB_HOST=127.0.0.1
DIKA_DB_USER=dika_app
DIKA_DB_PASSWORD=degistir-bu-degeri-guclu-bir-sifreyle
DIKA_DB_NAME=dika_db

# Werkzeug debug modu. Production'da HER ZAMAN false olmali.
DIKA_DEBUG=false
